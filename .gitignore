# Allowlist: ignore everything, then un-ignore only scripts and docs.
# New tracked files must be added here explicitly.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/run.sh
!/get-iso.sh
!/scripts/
!/share/
!/.claude/

share/*
!share/guest-ssh-setup.sh

# Belt and braces, anywhere in the tree
*.iso
*.iso.version
*.qcow2
*.img
*.fd
*.png
*.log
*.tmp
host-keys.pub
